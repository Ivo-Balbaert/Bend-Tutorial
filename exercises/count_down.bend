# count from 10 down to 0
# on 0: "Launch rocket!"
import Base

def counting(+n: Nat) -> IO(Unit):
  match n:
    case 0n:
      IO.print("Launch rocket!!!")
    case 1n+p:
      do IO<Unit>:
        IO.print(Nat.show(p) ++ "...")
        counting(p)

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print("Starting countdown")
    counting(10n)

# =>
# Starting countdown
# 9...
# 8...
# 7...
# 6...
# 5...
# 4...
# 3...
# 2...
# 1...
# 0...
# Launch rocket!!!